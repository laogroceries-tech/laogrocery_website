---
import { site, faqs, withBase } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  // For pages not ready for search results (e.g. placeholder policy text).
  noindex?: boolean;
  // The FAQ structured data describes the home page's FAQ section only.
  faq?: boolean;
}

const {
  title = `${site.fullName} — Grocery Delivery in Mandideep, MP`,
  description = site.description,
  noindex = false,
  faq = true,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, site.url);

// An online store run by a company, not a walk-in shop: GroceryStore/
// LocalBusiness would make Google expect a street address customers visit.
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "OnlineStore",
  name: site.fullName,
  alternateName: site.name,
  legalName: site.legal.name,
  url: site.url,
  logo: new URL(withBase("/logo.png"), site.url).href,
  description: site.description,
  email: site.supportEmail,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.legal.address.street,
    addressLocality: site.legal.address.locality,
    addressRegion: site.legal.address.region,
    postalCode: site.legal.address.postalCode,
    addressCountry: site.legal.address.country,
  },
  areaServed: {
    "@type": "City",
    name: site.foundingCity,
  },
  sameAs: Object.values(site.social),
  contactPoint: [
    ...site.supportPhones.map((phone) => ({
      "@type": "ContactPoint",
      contactType: "customer support",
      email: site.supportEmail,
      telephone: phone,
      areaServed: "IN",
      availableLanguage: ["English", "Hindi"],
    })),
    {
      "@type": "ContactPoint",
      contactType: "sales",
      email: site.businessEmail,
      areaServed: "IN",
    },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta charset="utf-8" />
<meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
<meta name="theme-color" content="#245420" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={site.fullName} />
<meta property="og:locale" content="en_IN" />
<meta property="og:image" content={new URL(withBase("/og-image.png"), site.url)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(withBase("/og-image.png"), site.url)} />

<link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
<link rel="icon" type="image/png" sizes="32x32" href={withBase("/favicon-32.png")} />
<link rel="icon" type="image/png" sizes="64x64" href={withBase("/favicon-64.png")} />
<link rel="apple-touch-icon" sizes="180x180" href={withBase("/apple-touch-icon.png")} />

<script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />
{faq && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />}
