---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import PlayBadge from "./PlayBadge.astro";
import { site, footerLinks, legalLinks, storeLocations, withBase } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-brand-900 text-white">
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-br from-brand-800/60 via-brand-900 to-neutral-950"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="sm:col-span-2 lg:col-span-2">
        <Logo variant="light" />
        <p class="mt-4 max-w-sm text-sm text-brand-100">
          From your neighborhood to your doorstep, {site.name} brings convenience closer.
        </p>
        <p class="mt-2 text-sm font-semibold text-white">A venture of {site.legal.name}</p>
        <div class="mt-6 flex items-center gap-3">
          <a href={site.social.instagram} aria-label="LAO on Instagram" class="flex size-9 items-center justify-center rounded-full bg-white/10 transition-colors hover:bg-white/20">
            <Icon name="instagram" class="size-4" />
          </a>
          <a href={site.social.facebook} aria-label="LAO on Facebook" class="flex size-9 items-center justify-center rounded-full bg-white/10 transition-colors hover:bg-white/20">
            <Icon name="facebook" class="size-4" />
          </a>
          <a href={site.social.linkedin} aria-label="LAO on LinkedIn" class="flex size-9 items-center justify-center rounded-full bg-white/10 transition-colors hover:bg-white/20">
            <Icon name="linkedin" class="size-4" />
          </a>
        </div>
      </div>

      <div>
        <h3 class="text-sm font-bold uppercase tracking-wide text-brand-200">Shop</h3>
        <ul class="mt-4 space-y-2 text-sm text-brand-100">
          {footerLinks.shop.map((item) => (
            <li>
              <a href={withBase("/#services")} class="transition-colors hover:text-white">{item}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-bold uppercase tracking-wide text-brand-200">Help</h3>
        <ul class="mt-4 space-y-2 text-sm text-brand-100">
          {footerLinks.help.map((item) => (
            <li>
              <a href={item.href} class="transition-colors hover:text-white">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-12 grid gap-8 border-t border-white/10 pt-8 text-sm text-brand-100 sm:grid-cols-3">
      <div id="contact" class="scroll-mt-32">
        <h3 class="text-sm font-bold uppercase tracking-wide text-brand-200">Customer Support</h3>
        <p class="mt-3">
          <a href={`mailto:${site.supportEmail}`} class="hover:text-white">{site.supportEmail}</a>
        </p>
        {site.supportPhones.map((phone) => (
          <p class="mt-1">
            <a href={`tel:${phone.replace(/[^+\d]/g, "")}`} class="whitespace-nowrap hover:text-white">{phone}</a>
          </p>
        ))}
        <p class="mt-1 text-xs text-brand-200">{site.supportHours}</p>
      </div>
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wide text-brand-200">Business Enquiries</h3>
        <p class="mt-3">Partnerships, suppliers and press:</p>
        <p class="mt-1">
          <a href={`mailto:${site.businessEmail}`} class="hover:text-white">{site.businessEmail}</a>
        </p>
      </div>
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wide text-brand-200">Pickup Points</h3>
        <ul class="mt-3 space-y-3">
          {storeLocations.map((store) => (
            <li class="flex items-start gap-2">
              <Icon name="store" class="mt-0.5 size-4 shrink-0 text-brand-300" />
              <span>
                <span class="block font-semibold text-white">{store.name}</span>
                {store.area}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-8 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-6 sm:flex-row">
      <div class="text-center text-sm text-brand-200 sm:text-left">
        <p>&copy; {year} {site.legal.name}. Made for Bharat.</p>
        <p class="mt-2 text-xs">{site.name} is a venture of {site.legal.name} · CIN: {site.legal.cin}</p>
        <p class="mt-1 text-xs">Registered office: {site.legal.registeredOffice}</p>
        <ul class="mt-3 flex flex-wrap justify-center gap-x-4 gap-y-1 text-xs sm:justify-start">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="underline-offset-2 hover:text-white hover:underline">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <PlayBadge class="bg-white/10 px-4 py-2.5" captionClass="text-brand-200" />
    </div>
  </div>
</footer>
