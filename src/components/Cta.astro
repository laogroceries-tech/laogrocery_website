---
import Icon from "./Icon.astro";
import PlayBadge from "./PlayBadge.astro";
import { site, primaryCta } from "../data/site";
---

<section class="bg-brand-900 py-16 text-center sm:py-20" aria-labelledby="cta-heading">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
    <h2 id="cta-heading" class="text-3xl font-extrabold text-white sm:text-4xl">
      Order Online Today
    </h2>
    <p class="mt-4 text-brand-100">
      Order from {site.name} on the web today: your first delivery is free, and so is every order of ₹{site.freeDeliveryAbove} or more. No hidden charges — just fresh groceries at your doorstep.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a
        href={primaryCta.href}
        class="inline-flex items-center gap-2 rounded-full bg-white px-8 py-3.5 text-base font-semibold text-brand-900 transition-colors hover:bg-brand-100"
      >
        {primaryCta.label}
        <Icon name="arrow-up-right" class="size-4" />
      </a>
      {!site.playStoreUrl && <PlayBadge class="bg-neutral-950 px-6 py-3.5" size="base" />}
    </div>
  </div>
</section>
